Multiplayer"]}, {"id": 7, "name": "Battle for Wesnoth", "desc": "استراتيجية تكتيكية بنظام الأدوار مع حملات فردية ومعارك جماعية.", "download": "https://www.wesnoth.org/downloads/", "official": "https://www.wesnoth.org/downloads/", "visual": null, "emoji": "🏹", "tags": ["🏹 استراتيجية", "⚔️ أدوار", "💾 مجانية", "🖥️ Windows"]}, {"id": 8, "name": "OpenRCT2", "desc": "ابنِ وأدر مدينة ملاهي، واهتم بالألعاب والزوار والمال.", "download": "https://openrct2.org/downloads", "official": "https://openrct2.org/downloads", "visual": null, "emoji": "🎢", "tags": ["🎢 محاكاة", "🏗️ إدارة", "💾 مجانية", "🖥️ Windows"]}, {"id": 9, "name": "OpenTTD", "desc": "أدر شركة نقل كاملة بالقطارات والشاحنات والطائرات والسفن.", "download": "https://www.openttd.org/downloads/openttd-releases/latest.html", "official": "https://www.openttd.org/downloads/openttd-releases/latest.html", "visual": null, "emoji": "🚂", "tags": ["🚂 إدارة", "🏗️ محاكاة", "💾 مجانية", "🖥️ Windows"]}, {"id": 10, "name": "FreeCiv", "desc": "استراتيجية حضارات تعتمد على التطور والتوسع والدبلوماسية عبر العصور.", "download": "https://www.freeciv.org/download/", "official": "https://www.freeciv.org/download/", "visual": null, "emoji": "🏰", "tags": ["🏰 استراتيجية", "🌍 حضارات", "💾 مجانية", "🖥️ Windows"]}, {"id": 11, "name": "SuperTux", "desc": "لعبة منصات ومغامرات كلاسيكية بشخصية Tux ومراحل متعددة.", "download": "https://www.supertux.org/download.html", "official": "https://www.supertux.org/download.html", "visual": null, "emoji": "🏃", "tags": ["🏃 منصات", "🗺️ مغامرة", "💾 مجانية", "🖥️ Windows"]}, {"id": 12, "name": "Secret Maryo Chronicles", "desc": "لعبة منصات ثنائية الأبعاد مليئة بالمراحل والأعداء والاستكشاف.", "download": "https://secretmaryo.org/download/", "official": "https://secretmaryo.org/download/", "visual": null, "emoji": "🧙", "tags": ["🧙 منصات", "🎮 مغامرة", "💾 مجانية", "🖥️ Windows"]}, {"id": 13, "name": "Armagetron Advanced", "desc": "سباق أركيد ثلاثي الأبعاد سريع مستوحى من الدراجات الضوئية.", "download": "https://armagetronad.org/downloads.php", "official": "https://armagetronad.org/downloads.php", "visual": null, "emoji": "🛸", "tags": ["🛸 أركيد", "🏁 سباق", "💾 مجانية", "🌐 Multiplayer"]}, {"id": 14, "name": "Extreme Tux Racer", "desc": "انزل المنحدرات الجليدية بأقصى سرعة وحاول تحقيق أفضل زمن.", "download": "https://extremetuxracer.com/", "official": "https://extremetuxracer.com/", "visual": null, "emoji": "🏁", "tags": ["🏁 سباق", "❄️ ثلج", "💾 مجانية", "🖥️ Windows"]}, {"id": 15, "name": "StepMania", "desc": "لعبة إيقاع وموسيقى تعتمد على التوقيت والسرعة والتنسيق.", "download": "https://stepmania.com/download/", "official": "https://stepmania.com/download/", "visual": null, "emoji": "🎵", "tags": ["🎵 موسيقى", "💃 إيقاع", "💾 مجانية", "🖥️ Windows"]}, {"id": 16, "name": "Hedgewars", "desc": "لعبة استراتيجية جماعية مضحكة تعتمد على فرق من القنافذ والأسلحة.", "download": "https://www.hedgewars.org/download.html", "official": "https://www.hedgewars.org/download.html", "visual": null, "emoji": "🏹", "tags": ["🏹 استراتيجية", "💥 أركيد", "💾 مجانية", "🌐 Multiplayer"]}, {"id": 17, "name": "Warzone 2100", "desc": "استراتيجية حربية في الزمن الحقيقي مع بناء قواعد وأبحاث ووحدات قتالية.", "download": "https://wz2100.net/download/", "official": "https://wz2100.net/download/", "visual": null, "emoji": "🚀", "tags": ["🚀 استراتيجية", "💥 حروب", "💾 مجانية", "🖥️ Windows"]}, {"id": 18, "name": "TORCS", "desc": "محاكاة سباقات سيارات مفتوحة المصدر مع حلبات وسيارات متعددة.", "download": "https://sourceforge.net/projects/torcs/files/", "official": "https://sourceforge.net/projects/torcs/files/", "visual": null, "emoji": "🏎️", "tags": ["🏎️ محاكاة", "🚘 سيارات", "💾 مجانية", "🖥️ Windows"]}, {"id": 19, "name": "Minetest Game", "desc": "تجربة بناء واستكشاف وبقاء داخل عالم مكعبات مفتوح.", "download": "https://www.luanti.org/en/downloads/", "official": "https://www.luanti.org/en/downloads/", "visual": null, "emoji": "🎮", "tags": ["🎮 بقاء", "⛏️ بناء", "💾 مجانية", "🖥️ Windows"]}, {"id": 20, "name": "Unciv", "desc": "لعبة استراتيجية لبناء الحضارات\nوإدارة المدن والتوسع.", "download": "https://f-droid.org/en/packages/com.unciv.app/", "official": "https://f-droid.org/en/packages/com.unciv.app/", "visual": null, "emoji": "🏛️", "tags": ["🏛️ استراتيجية", "📱 Android", "💾 مجانية", "🌐 مفتوحة المصدر"]}, {"id": 21, "name": "Shattered Pixel Dungeon", "desc": "لعبة مغامرات وألغاز داخل زنزانات\nمع تحديات وأسلوب لعب ممتع.", "download": "https://f-droid.org/en/packages/com.shatteredpixel.shatteredpixeldungeon/", "official": "https://f-droid.org/en/packages/com.shatteredpixel.shatteredpixeldungeon/", "visual": null, "emoji": "💎", "tags": ["🧙 مغامرات", "📱 Android", "💾 مجانية", "🌐 مفتوحة المصدر"]}, {"id": 22, "name": "Mindustry", "desc": "ابنِ المصانع ودافع عن قاعدتك\nوأدر الموارد في لعبة استراتيجية وصناعة.", "download": "https://f-droid.org/en/packages/io.anuke.mindustry/", "official": "https://f-droid.org/en/packages/io.anuke.mindustry/", "visual": null, "emoji": "🏭", "tags": ["🏭 استراتيجية", "📱 Android", "💾 مجانية", "🌐 مفتوحة المصدر"]}];
let heroIndex=0, heroTimer, activeFilter="all";

function coverStyle(g){
  return g.visual ? `background-image:linear-gradient(135deg,rgba(7,11,20,.15),rgba(49,46,129,.35)),url("${g.visual}")` : "";
}
function renderGames(){
  const q=(document.getElementById("search").value||"").trim().toLowerCase();
  const grid=document.getElementById("gameGrid"); grid.innerHTML="";
  let count=0;
  GAMES.forEach((g,i)=>{
    const text=(g.name+" "+g.desc+" "+g.tags.join(" ")).toLowerCase();
    const isMobile=g.tags.some(t=>t.includes("Android"));
    const isRace=g.tags.some(t=>t.includes("سباق"));
    const isStrategy=g.tags.some(t=>t.includes("استراتيجية"));
    const filterOk=activeFilter==="all" || (activeFilter==="mobile"&&isMobile) || (activeFilter==="pc"&&!isMobile) || (activeFilter==="race"&&isRace) || (activeFilter==="strategy"&&isStrategy);
    if(!filterOk || (q && !text.includes(q))) return;
    count++;
    const card=document.createElement("article"); card.className="card";
    const tags=g.tags.slice(0,4).map(t=>`<span class="tag">${esc(t)}</span>`).join("");
    card.innerHTML=`<div class="cover" style="${coverStyle(g)}"><span class="cover-badge">${g.tags[0]||"FREE"}</span>${g.visual?"":esc(g.emoji)}</div>
      <div class="body"><h3>${esc(g.name)}</h3><p>${esc(g.desc)}</p><div class="tags">${tags}</div>
      <div class="actions"><button class="details" onclick="openGame(${i})">📄 التفاصيل</button><a class="download" href="${escAttr(g.download)}" target="_blank" rel="noopener">⬇️ تحميل</a></div></div>`;
    grid.appendChild(card);
  });
  document.getElementById("empty").classList.toggle("hidden",count!==0);
}

function setFilter(filter,btn){activeFilter=filter;document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));btn.classList.add('active');renderGames()}
function openGame(i){
  const g=GAMES[i]; if(!g)return;
  document.getElementById("gameTitle").textContent=g.name;
  document.getElementById("gameCrumb").textContent="🎮 تكنومسار › "+g.name;
  document.getElementById("gameDesc").textContent=g.desc;
  document.getElementById("gameLong").textContent=g.desc+" يمكنك الرجوع للمتجر واختيار لعبة أخرى في أي وقت.";
  document.getElementById("gameTags").innerHTML=g.tags.map(t=>`<span class="big-tag">${esc(t)}</span>`).join("");
  const cover=document.getElementById("gameCover"); cover.textContent=g.visual?"":g.emoji; cover.style=coverStyle(g);
  const dl=document.getElementById("gameDownload"); dl.href=g.download;
  const of=document.getElementById("gameOfficial"); of.href=g.official;
  const rec=document.getElementById("recommend"); rec.innerHTML="";
  GAMES.filter((x,j)=>j!==i).slice(0,5).forEach(x=>{const j=GAMES.indexOf(x);const b=document.createElement("div");b.className="rec";b.textContent="🎮 "+x.name;b.onclick=()=>openGame(j);rec.appendChild(b)});
  document.getElementById("gamePage").classList.add("show");document.getElementById("gamePage").setAttribute("aria-hidden","false");document.body.style.overflow="hidden";history.pushState({game:i},"","#"+encodeURIComponent(g.name));
}
function closeGame(){document.getElementById("gamePage").classList.remove("show");document.getElementById("gamePage").setAttribute("aria-hidden","true");document.body.style.overflow="";if(location.hash)history.pushState(null,"",location.pathname+location.search)}
function setHero(i){
  heroIndex=i; const g=GAMES[i]; if(!g)return;
  document.getElementById("heroTitle").textContent=g.name;
  document.getElementById("heroDesc").textContent=g.desc;
  const art=document.getElementById("heroArt"); art.style=coverStyle(g);
  document.querySelectorAll(".dot").forEach((d,j)=>d.classList.toggle("active",j===i));
}
function initHero(){
  const dots=document.getElementById("dots"); dots.innerHTML="";
  GAMES.slice(0,6).forEach((_,i)=>{const d=document.createElement("button");d.className="dot"+(i===0?" active":"");d.onclick=()=>{setHero(i);resetHero()};dots.appendChild(d)});
  setHero(0);resetHero();
}
function resetHero(){clearInterval(heroTimer);heroTimer=setInterval(()=>setHero((heroIndex+1)%Math.min(6,GAMES.length)),5000)}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function escAttr(s){return esc(s)}
window.addEventListener("popstate",()=>{if(document.getElementById("gamePage").classList.contains("show"))closeGame()});
renderGames();initHero();
</script>
</body></html>
