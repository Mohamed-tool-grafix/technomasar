<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>تكنومسار | متجر الألعاب</title>
<meta name="description" content="تكنومسار — متجر ألعاب عربي بواجهة احترافية.">
<style>
:root{--bg:#060912;--panel:#0b1220;--panel2:#0e1829;--line:#1c2b42;--text:#f4f8ff;--muted:#91a2ba;--cyan:#38d8ff;--blue:#4f7cff;--green:#28d17c;--shadow:0 24px 70px rgba(0,0,0,.42)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 10% -10%,#102d46 0,transparent 30%),radial-gradient(circle at 100% 0,#17183b 0,transparent 27%),var(--bg);color:var(--text);font-family:"Segoe UI",Tahoma,Arial,sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,#000,transparent 70%);z-index:-1}a{text-decoration:none;color:inherit}button,input{font:inherit}.wrap{width:min(1240px,92%);margin:auto}
header{position:sticky;top:0;z-index:100;background:rgba(5,9,17,.76);backdrop-filter:blur(22px);border-bottom:1px solid rgba(120,160,210,.12)}.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{display:flex;align-items:center;gap:11px;font-weight:1000;font-size:22px;color:#fff}.logo-mark{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,var(--cyan),#5571ff);box-shadow:0 0 30px #38d8ff35}.logo small{display:block;color:#7f91aa;font-size:9px;letter-spacing:2.4px;margin-top:2px}.links{display:flex;gap:5px;flex-wrap:wrap}.links a{padding:10px 13px;border-radius:10px;color:#9eacc0;font-weight:700}.links a:hover{background:#111d30;color:#fff}.nav-pill{border:1px solid #243751;background:#0c1726;padding:9px 13px;border-radius:11px;color:#b8c8db;font-size:13px}
.hero{position:relative;min-height:545px;display:flex;align-items:center;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.06)}.hero-art{position:absolute;inset:-25px;background-size:cover;background-position:center;opacity:.32;filter:saturate(1.25);transition:.7s}.hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 75% 45%,rgba(56,216,255,.16),transparent 27%),linear-gradient(90deg,rgba(6,9,18,1) 0%,rgba(6,9,18,.82) 42%,rgba(6,9,18,.3) 100%);z-index:1}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,var(--bg),transparent 22%);z-index:1}.hero-content{position:relative;z-index:2;padding:75px 0;max-width:790px}.eyebrow{color:var(--cyan);font-size:13px;font-weight:1000;letter-spacing:1.7px;text-transform:uppercase}.hero h1{font-size:clamp(48px,7vw,82px);line-height:.98;letter-spacing:-2px;margin:14px 0 18px}.hero h1 span{color:var(--cyan)}.hero p{font-size:18px;color:#b5c3d6;line-height:1.95;max-width:690px}.hero-buttons{display:flex;gap:11px;flex-wrap:wrap;margin-top:27px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 19px;border-radius:13px;border:1px solid #293d5b;background:#101b2b;font-weight:900;transition:.2s}.btn.primary{background:linear-gradient(135deg,var(--cyan),#5680ff);color:#03111b;border-color:transparent;box-shadow:0 10px 30px #38d8ff20}.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}.dots{display:flex;gap:8px;margin-top:27px}.dot{width:28px;height:4px;border:0;border-radius:20px;background:#304158;cursor:pointer;transition:.25s}.dot.active{width:48px;background:var(--cyan)}
.section{padding:70px 0}.head{margin-bottom:25px}.head-row{display:flex;justify-content:space-between;align-items:end;gap:20px}.head h2{font-size:38px;letter-spacing:-1px;margin:7px 0;color:#fff}.head p{color:var(--muted);margin:0;line-height:1.8}.library-stats{display:flex;gap:8px;flex-wrap:wrap}.stat{padding:9px 12px;border:1px solid var(--line);background:#0a1321;border-radius:11px;color:#9fb0c7;font-size:12px}.stat b{color:#fff}
.toolbar{display:flex;gap:12px;align-items:center;margin:25px 0 20px;flex-wrap:wrap}.search{display:flex;gap:9px;flex:1;min-width:260px}.search input{width:100%;padding:15px 17px;border-radius:13px;border:1px solid #223550;background:rgba(10,19,33,.9);color:#fff;outline:none;box-shadow:inset 0 1px #ffffff05}.search input:focus{border-color:#38d8ff77;box-shadow:0 0 0 4px #38d8ff0d}.search button{padding:0 17px;border-radius:13px;border:1px solid #263a55;background:#111d2d;color:#c6d2e0;cursor:pointer}.filters{display:flex;gap:7px;flex-wrap:wrap}.filter{padding:10px 13px;border-radius:11px;border:1px solid #223550;background:#0b1422;color:#9eafc3;cursor:pointer;font-weight:800}.filter.active,.filter:hover{background:#112b3d;color:#66e4ff;border-color:#2b7891}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:17px}.card{position:relative;background:linear-gradient(155deg,rgba(16,27,45,.96),rgba(8,14,24,.96));border:1px solid #1c2d44;border-radius:19px;overflow:hidden;transition:.28s;box-shadow:0 10px 35px #0002}.card:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,transparent 35%,#ffffff04,transparent 65%);transform:translateX(-100%);transition:.5s}.card:hover{transform:translateY(-7px);border-color:#2e8fa9;box-shadow:0 25px 55px #0007}.card:hover:after{transform:translateX(100%)}.cover{height:190px;position:relative;display:flex;align-items:center;justify-content:center;font-size:76px;background:radial-gradient(circle at 25% 20%,#28d8ff55,transparent 25%),linear-gradient(135deg,#102e4b,#31245e);background-size:cover;background-position:center}.cover:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,9,16,.8),transparent 58%)}.cover-badge{position:absolute;top:12px;right:12px;padding:6px 9px;border-radius:8px;background:#06101ccc;border:1px solid #ffffff18;color:#bdefff;font-size:11px;font-weight:900}.body{padding:17px}.body h3{margin:0 0 7px;font-size:21px}.body p{color:#9eafc2;min-height:56px;line-height:1.7;font-size:14px}.tags{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 15px}.tag{font-size:11px;color:#abc3d8;background:#111f32;border:1px solid #22364f;padding:5px 8px;border-radius:8px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.actions button,.actions a{padding:11px;border-radius:10px;text-align:center;font-weight:900;border:1px solid #263d58;cursor:pointer}.details{background:#14263a;color:#8feaff}.download{background:linear-gradient(135deg,#16a75d,#20ca79);color:#03150b;border-color:transparent!important}.hidden{display:none!important}.empty{text-align:center;padding:55px;color:#8fa0b7}
footer{padding:45px 0;text-align:center;color:#718197;border-top:1px solid #172438;background:#050914}.footer-brand{color:#dce9f8;font-weight:900}
#gamePage{position:fixed;inset:0;z-index:1000;display:none;background:radial-gradient(circle at 70% 0,#132b45,transparent 30%),#050a12;overflow:auto}#gamePage.show{display:block}.gamebar{position:sticky;top:0;z-index:3;height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 4%;background:rgba(5,10,18,.82);backdrop-filter:blur(20px);border-bottom:1px solid #1b2d43}.back{border:1px solid #29445f;background:#0d1b2c;color:#fff;padding:10px 15px;border-radius:11px;cursor:pointer;font-weight:800}.game-main{width:min(1240px,92%);margin:auto;padding:40px 0 100px}.game-hero{display:grid;grid-template-columns:42% 1fr;gap:30px;align-items:stretch}.game-cover{min-height:390px;border-radius:24px;border:1px solid #29445f;background:radial-gradient(circle at 25% 20%,#38d8ff55,transparent 30%),linear-gradient(135deg,#075985,#312e81);background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;font-size:125px;overflow:hidden;box-shadow:var(--shadow);position:relative}.game-cover:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#02050acc,transparent 55%)}.game-info{padding:15px 0}.game-info h1{font-size:clamp(42px,6vw,70px);letter-spacing:-2px;margin:0 0 13px}.game-info p{color:#b4c2d3;font-size:18px;line-height:2;max-width:760px}.big-tags{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.big-tag{padding:7px 11px;border-radius:9px;background:#10283c;border:1px solid #274b67;color:#aeefff;font-size:13px;font-weight:800}.game-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.game-actions a{padding:14px 23px;border-radius:12px;font-weight:900;min-width:190px;text-align:center}.game-download{background:linear-gradient(135deg,#18ad62,#25d27f);color:#02150a}.game-official{background:#0b1a2c;border:1px solid #0879c9;color:#8feaff}.panels{display:grid;grid-template-columns:1fr 320px;gap:18px;margin-top:25px}.panel{background:linear-gradient(145deg,#081726dd,#0a1422dd);border:1px solid #203b54;border-radius:18px;padding:25px}.panel h2{margin-top:0;color:#fff}.panel p{color:#bac7d4;line-height:2}.recommend{display:grid;gap:8px}.rec{padding:11px;border:1px solid #243b52;border-radius:11px;color:#bcd0e2;cursor:pointer}.rec:hover{border-color:#18c5eb;background:#0e2031}
@media(max-width:900px){.links{display:none}.hero{min-height:570px}.head-row{align-items:start;flex-direction:column}.game-hero,.panels{grid-template-columns:1fr}.game-cover{min-height:270px;font-size:95px}.game-actions a{width:100%}}@media(max-width:520px){.wrap{width:94%}.nav-pill{display:none}.hero-content{padding:60px 0}.hero h1{font-size:48px}.grid{grid-template-columns:1fr}.toolbar{align-items:stretch}.search{min-width:100%}.filters{width:100%}.filter{flex:1}.game-main{width:94%}}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="logo" href="#top"><span class="logo-mark">🎮</span><span>تكنومسار<small>GAME STORE</small></span></a><nav class="links"><a href="#top">الرئيسية</a><a href="#games">المكتبة</a><a href="#games">الكمبيوتر</a><a href="#games">الموبايل</a></nav><div class="nav-pill">⚡ مجاني • مفتوح المصدر</div></div></header>

<section class="hero" id="top"><div class="hero-art" id="heroArt"></div><div class="wrap hero-content">
<div class="eyebrow">✨ متجر ألعاب عربي</div><h1 id="heroTitle">اكتشف <span>لعبتك</span> القادمة</h1><p id="heroDesc">مجموعة من الألعاب المجانية والمفتوحة المصدر، بتجربة تصفح سريعة وواجهة احترافية.</p>
<div class="hero-buttons"><button class="btn primary" onclick="openGame(heroIndex)">🎮 عرض اللعبة</button><a class="btn" href="#games">استكشف الألعاب ↓</a></div><div class="dots" id="dots"></div>
</div></section>

<main class="wrap">
<section class="section" id="games"><div class="head"><div class="head-row"><div><div class="eyebrow">GAME LIBRARY</div><h2>🎮 مكتبة الألعاب</h2><p>كل ألعاب المتجر في مكان واحد — ابحث، صفِّ النتائج، وافتح صفحة أي لعبة.</p></div><div class="library-stats"><div class="stat">🎮 الألعاب <b>23</b></div><div class="stat">💾 مجانية <b>23</b></div><div class="stat">🌐 مفتوحة المصدر <b>20+</b></div></div></div></div><div class="toolbar"><div class="search"><input id="search" type="search" placeholder="🔎 ابحث عن لعبة..." oninput="renderGames()"><button onclick="document.getElementById('search').value='';renderGames()">مسح</button></div><div class="filters"><button class="filter active" onclick="setFilter('all',this)">الكل</button><button class="filter" onclick="setFilter('pc',this)">🖥️ كمبيوتر</button><button class="filter" onclick="setFilter('mobile',this)">📱 موبايل</button><button class="filter" onclick="setFilter('race',this)">🏎️ سباق</button><button class="filter" onclick="setFilter('strategy',this)">⚔️ استراتيجية</button></div></div><div class="grid" id="gameGrid"></div><div class="empty hidden" id="empty">لا توجد لعبة مطابقة للبحث.</div></section>
</main>
<footer>© 2026 <span class="footer-brand">تكنومسار</span> — متجر ألعاب عربي احترافي<br><small>استكشف الألعاب المجانية والمفتوحة المصدر من واجهة واحدة.</small></footer>

<div id="gamePage" aria-hidden="true"><div class="gamebar"><div id="gameCrumb">🎮 صفحة اللعبة</div><button class="back" onclick="closeGame()">✕ إغلاق</button></div>
<div class="game-main"><div class="game-hero"><div class="game-cover" id="gameCover"></div><div class="game-info"><h1 id="gameTitle"></h1><div class="big-tags" id="gameTags"></div><p id="gameDesc"></p><div class="game-actions"><a id="gameDownload" class="game-download" target="_blank" rel="noopener">⬇️ تحميل اللعبة</a><a id="gameOfficial" class="game-official" target="_blank" rel="noopener">🔗 الموقع الرسمي</a></div></div></div>
<div class="panels"><div class="panel"><h2>📖 عن اللعبة</h2><p id="gameLong"></p><h2>⭐ لماذا قد تعجبك؟</h2><p>واجهة متجر سريعة، معلومات واضحة، وزر تحميل مباشر من الرابط الموجود في بيانات اللعبة.</p></div>
<aside class="panel"><h2>🎮 ألعاب أخرى</h2><div class="recommend" id="recommend"></div></aside></div></div></div>

